# Copy the original backend/.env here first. Never commit real credentials.
# Personal model credentials are encrypted with this stable secret (>=32 characters).
# If empty, the existing JWT secret is used. Back it up separately from the database.
MED_MODEL_KEY_SECRET=
# Exact HTTPS base URLs. No automatic redirects or arbitrary user-supplied hosts.
MED_USER_MODEL_BASE_URLS=https://api.deepseek.com,https://api.deepseek.com/v1,https://open.bigmodel.cn/api/paas/v4,https://opencode.ai/zen/go/v1,https://api.openai.com/v1
# Single-process active chat limit. The 11th concurrent user receives HTTP 503.
MED_MAX_CONCURRENT_CHATS=10
LLM_PROVIDER=glm
# Restricted Agent and semantic review use OpenCode; natural answers retain original GLM/DeepSeek provider.
OPENCODE_API_KEY=
AGENT_BASE_URL=https://opencode.ai/zen/go/v1
AGENT_MODEL=deepseek-v4-flash
GLM_API_KEY=
GLM_MODEL=glm-4.5-air
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
MED_PROVIDER=compatible
MED_QA_ENABLED=false
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Original local models. No model downloads at startup.
EMBEDDING_MODEL_PATH=C:/model/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL_PATH=C:/model/bge-reranker-large
MED_MODEL_DEVICE=cpu
CHROMA_PATH=../data/chroma
COLLECTION_NAME=medical_qa
DATA_ROOT=C:/path/to/medical_cleaned_zh
# Select one business persistence backend for accounts, history and L3/L4 memory.
MED_DATABASE_BACKEND=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=medical_agentic_rag
# Original MySQL settings remain available as an alternative.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=medical_agentic_rag
MYSQL_CHARSET=utf8mb4
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
MED_REDIS_ENABLED=true
MED_NEO4J_URI=bolt://127.0.0.1:7687
MED_NEO4J_USERNAME=neo4j
MED_NEO4J_PASSWORD=
MED_NEO4J_DATABASE=abc
MED_MAX_ITERATIONS=3
MED_MAX_MODEL_CALLS=6
MED_REQUEST_TIMEOUT=90
MED_LLM_TIMEOUT=20
MED_PUBMED_ENABLED=false
MED_HOST=127.0.0.1
MED_PORT=8010
# Original optional integrations; not available to the Agent.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
SENDER_EMAIL=
SENDER_EMAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
WEATHER=
