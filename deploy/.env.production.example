# MediAtlas 生产环境变量模板（复制为 backend/.env 后使用）
# 注意：真实 .env 绝不进版本库；deploy.sh 会自动生成强随机口令。
# 容器内服务名（postgres/redis/neo4j）由 docker-compose 覆盖，这里保持 127.0.0.1 仅供本机排查。

# ---------- 运行模式 ----------
MED_PROVIDER=compatible
MED_HOST=0.0.0.0
MED_PORT=8010
MED_DATABASE_BACKEND=postgres
MED_QA_ENABLED=false

# ---------- 回答模型（GLM）与 Agent 模型（OpenCode Go） ----------
LLM_PROVIDER=glm
GLM_API_KEY=__GLM_API_KEY__
GLM_MODEL=glm-4.5-air
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
OPENCODE_API_KEY=__OPENCODE_API_KEY__
AGENT_BASE_URL=https://opencode.ai/zen/go/v1
AGENT_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- 本地模型（容器内路径，由 compose 挂载 ./models） ----------
EMBEDDING_MODEL_PATH=/models/paraphrase-multilingual-MiniLM-L12-v2
RERANKER_MODEL_PATH=/models/bge-reranker-large
MED_MODEL_DEVICE=cpu

# ---------- PostgreSQL ----------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=mediatlas
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DATABASE=medical_agentic_rag

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=__REDIS_PASSWORD__
MED_REDIS_ENABLED=true
MED_REDIS_URL=redis://:__REDIS_PASSWORD__@127.0.0.1:6379/0

# ---------- Neo4j（务必改掉默认 12345678） ----------
MED_NEO4J_URI=bolt://127.0.0.1:7687
MED_NEO4J_USERNAME=neo4j
MED_NEO4J_PASSWORD=__NEO4J_PASSWORD__
MED_NEO4J_DATABASE=neo4j

# ---------- 安全与会话 ----------
MED_JWT_SECRET=__JWT_SECRET__
SECRET_KEY=__JWT_SECRET__
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
# 上 HTTPS 后必须改为 true
MED_SECURE_COOKIE=false
# 改为实际访问地址（IP 或域名），逗号分隔
MED_ALLOWED_ORIGINS=http://__PUBLIC_HOST__:8010

# ---------- 限流与预算（2 vCPU 机器务必压低并发） ----------
MED_MAX_CONCURRENT_CHATS=3
MED_REQUESTS_PER_MINUTE=20
MED_REQUEST_TIMEOUT=180
MED_MAX_ITERATIONS=3
MED_MAX_MODEL_CALLS=6
MED_LLM_TIMEOUT=30

# ---------- PubMed 文献（仅“最新/今年”类问题触发） ----------
MED_PUBMED_ENABLED=true
MED_PUBMED_EMAIL=__PUBMED_EMAIL__

# ---------- 其他 ----------
OLLAMA_BASE_URL=
SENDER_EMAIL=
SENDER_EMAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
WEATHER=
